{
    "name": "telegram-restricted-downloader",
    "displayName": "Telegram Restrcted Content Downloader - TG Downloader",
    "version": "3.12.2",
    "description": "A restricted content downloader for telegram or TG, use it to download image, video, sticker, audio, voice message",
    "author": "YZH",
    "scripts": {
        "dev": "plasmo dev",
        "build": "plasmo build --source-maps && pnpm sentry:sourcemaps",
        "package": "plasmo package && node assets.mjs",
        "sentry:sourcemaps": "sentry-cli sourcemaps inject --org trcd --project javascript-react ./build/chrome-mv3-prod && sentry-cli sourcemaps upload --org trcd --project javascript-react ./build/chrome-mv3-prod"
    },
    "dependencies": {
        "@plasmohq/messaging": "^0.6.2",
        "@plasmohq/storage": "^1.10.0",
        "@radix-ui/react-accordion": "^1.1.2",
        "@radix-ui/react-alert-dialog": "^1.0.5",
        "@radix-ui/react-popover": "^1.0.7",
        "@radix-ui/react-progress": "^1.0.3",
        "@radix-ui/react-slot": "^1.0.2",
        "@radix-ui/react-toast": "^1.1.5",
        "@radix-ui/react-tooltip": "^1.0.7",
        "@sentry/cli": "^2.35.0",
        "@sentry/react": "^8.28.0",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.1.1",
        "kodepay": "^2.1.2",
        "lucide-react": "^0.378.0",
        "plasmo": "0.88.0",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "swr": "^2.2.5",
        "tailwind-merge": "^2.3.0",
        "tailwindcss": "3.4.1",
        "tailwindcss-animate": "^1.0.7"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "4.1.1",
        "@types/chrome": "0.0.258",
        "@types/node": "20.11.5",
        "@types/react": "18.2.48",
        "@types/react-dom": "18.2.18",
        "postcss": "8.4.33",
        "prettier": "3.2.4",
        "typescript": "5.3.3"
    },
    "manifest": {
        "host_permissions": [
            "https://web.telegram.org/*"
        ],
        "permissions": [
            "scripting",
            "storage",
            "messaging"
        ]
    }
}
